<%# One expert card. Needs a variable called "expert" (with avgRating and ratingCount from addRating) %>
<div class="col">
  <div class="card h-100">
    <div class="card-body">
      <div class="d-flex align-items-center gap-3 mb-2">
        <div class="expert-avatar"><%= expert.name.replace('Dr. ', '').split(' ').map(function (w) { return w[0]; }).join('') %></div>
        <div>
          <h5 class="mb-0"><%= expert.name %></h5>
          <span class="badge bg-light text-dark"><%= expert.expertProfile.specialty %></span>
        </div>
      </div>
      <p class="text-muted small"><%= expert.expertProfile.qualifications %></p>
      <div>
        <% if (expert.ratingCount > 0) { %>
          <span class="stars"><%= stars(Math.round(expert.avgRating)) %></span>
          <%= expert.avgRating %> <span class="text-muted small">(<%= expert.ratingCount %>)</span>
        <% } else { %>
          <span class="text-muted small">No ratings yet</span>
        <% } %>
      </div>
    </div>
    <div class="card-footer bg-white border-0">
      <a href="/experts/<%= expert.id %>" class="btn btn-main btn-sm">View profile</a>
      <%- include('save_button', { expertId: expert.id }) %>
    </div>
  </div>
</div>
