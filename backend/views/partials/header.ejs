<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title : 'MedExpert Q&A' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>

  <nav class="navbar navbar-expand-md bg-white border-bottom">
    <div class="container">
      <a class="navbar-brand" href="/">🩺 MedExpert Q&amp;A</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="menu">
        <ul class="navbar-nav ms-auto">
          <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
          <li class="nav-item"><a class="nav-link" href="/experts">Experts</a></li>
          <li class="nav-item"><a class="nav-link" href="/questions">Q&amp;A</a></li>
          <% if (currentUser) { %>
            <li class="nav-item"><a class="nav-link" href="/dashboard">Dashboard</a></li>
            <%# Member C: notification bell with the number of unread notifications %>
            <li class="nav-item">
              <a class="nav-link" href="/dashboard#notifications" title="Notifications">🔔
                <% if (locals.unreadCount > 0) { %><span class="badge rounded-pill bg-danger"><%= unreadCount %></span><% } %>
              </a>
            </li>
            <li class="nav-item"><a class="nav-link" href="/logout">Log out (<%= currentUser.name %>)</a></li>
          <% } else { %>
            <li class="nav-item"><a class="nav-link" href="/login">Log in</a></li>
          <% } %>
        </ul>
      </div>
    </div>
  </nav>

  <%# Member C: pop-up alert while there are unread notifications (closes with the x) %>
  <% if (locals.unreadCount > 0) { %>
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
      <div class="toast show" role="alert">
        <div class="toast-header">
          <strong class="me-auto">🔔 MedExpert Q&amp;A</strong>
          <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body">
          You have <%= unreadCount %> new notification(s). <a href="/dashboard#notifications">Open dashboard</a>
        </div>
      </div>
    </div>
  <% } %>
