<%- include('partials/header', { title: title }) %>

  <div class="container my-4">
    <h1 class="mb-1">My dashboard</h1>
    <p class="text-muted">
      <% if (currentUser.role === 'expert') { %>
        Questions patients sent you. Waiting ones are shown first.
      <% } else { %>
        Track your questions, rate answers and see your saved experts.
      <% } %>
    </p>

    <% if (error) { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <%# ---------- Number cards ---------- %>
    <div class="row row-cols-1 row-cols-sm-3 g-3 mb-4">
      <% if (currentUser.role === 'expert') { %>
        <div class="col"><div class="card h-100"><div class="card-body">
          <div class="fs-2 fw-bold"><%= stats.waiting %></div><div class="text-muted">Waiting for reply</div>
        </div></div></div>
        <div class="col"><div class="card h-100"><div class="card-body">
          <div class="fs-2 fw-bold"><%= stats.answered %></div><div class="text-muted">Answered</div>
        </div></div></div>
        <div class="col"><div class="card h-100"><div class="card-body">
          <div class="fs-2 fw-bold"><%= stats.avgRating %> <span class="stars">★</span></div>
          <div class="text-muted">Average rating (<%= stats.ratingCount %>)</div>
        </div></div></div>
      <% } else { %>
        <div class="col"><div class="card h-100"><div class="card-body">
          <div class="fs-2 fw-bold"><%= stats.asked %></div><div class="text-muted">Questions asked</div>
        </div></div></div>
        <div class="col"><div class="card h-100"><div class="card-body">
          <div class="fs-2 fw-bold"><%= stats.answered %></div><div class="text-muted">Answered</div>
        </div></div></div>
        <div class="col"><div class="card h-100"><div class="card-body">
          <div class="fs-2 fw-bold"><%= stats.waiting %></div><div class="text-muted">Waiting</div>
        </div></div></div>
      <% } %>
    </div>

    <div class="row g-4">

      <%# ---------- LEFT: the questions ---------- %>
      <div class="col-12 col-lg-8">
        <h2 class="h4 mb-3"><%= currentUser.role === 'expert' ? 'Questions for you' : 'My questions' %></h2>

        <% if (questions.length === 0) { %>
          <div class="alert alert-secondary">
            <% if (currentUser.role === 'expert') { %>
              No questions have been sent to you yet.
            <% } else { %>
              You have not asked any questions yet. <a href="/experts">Find an expert</a>
            <% } %>
          </div>
        <% } %>

        <% questions.forEach(function (q) { %>
          <div class="card mb-3">
            <div class="card-body">

              <%# Top line: who, when, and the two badges %>
              <div class="d-flex justify-content-between align-items-start gap-2">
                <div class="text-muted small">
                  <% if (currentUser.role === 'expert') { %>
                    From <%= q.asker.name %> · <%= formatDate(q.createdAt) %>
                  <% } else { %>
                    To <a href="/experts/<%= q.expert.id %>"><%= q.expert.name %></a> · <%= formatDate(q.createdAt) %> ·
                    <span class="badge bg-light text-dark"><%= q.expert.expertProfile.specialty %></span>
                  <% } %>
                </div>
                <div>
                  <% if (q.answer === null) { %>
                    <span class="badge bg-warning text-dark">Waiting</span>
                  <% } else { %>
                    <span class="badge bg-success">Answered</span>
                  <% } %>
                  <span class="badge <%= q.isPublic ? 'bg-secondary' : 'bg-dark' %>"><%= q.isPublic ? 'Public' : 'Private' %></span>
                </div>
              </div>

              <h5 class="mt-2"><%= q.text %></h5>

              <% if (currentUser.role === 'expert') { %>
                <%# ===== EXPERT: reply box, or the answer + delete ===== %>
                <% if (q.answer === null) { %>
                  <form action="/questions/<%= q.id %>/answer" method="post" class="mt-3">
                    <label for="answer-<%= q.id %>" class="form-label small">Your answer</label>
                    <%# required + minlength = client-side validation; the route checks again %>
                    <textarea id="answer-<%= q.id %>" name="answer" class="form-control" rows="3"
                              required minlength="20" maxlength="2000"
                              placeholder="Write your answer (at least 20 characters)"></textarea>
                    <button type="submit" class="btn btn-main btn-sm mt-2">Send reply</button>
                  </form>
                <% } else { %>
                  <div class="answer-box mt-3"><%= q.answer %></div>
                  <div class="d-flex justify-content-between align-items-center mt-2">
                    <span class="small">
                      <% if (q.rating) { %>
                        Patient rated: <span class="stars"><%= stars(q.rating) %></span>
                      <% } else { %>
                        Not rated yet
                      <% } %>
                    </span>
                    <form action="/questions/<%= q.id %>/delete-answer" method="post"
                          onsubmit="return confirm('Delete your answer? The question will go back to Waiting.');">
                      <button type="submit" class="btn btn-outline-danger btn-sm">Delete my answer</button>
                    </form>
                  </div>
                <% } %>

              <% } else { %>
                <%# ===== USER: the answer + rating, or waiting ===== %>
                <% if (q.answer === null) { %>
                  <p class="text-muted fst-italic mt-3 mb-0">Waiting for <%= q.expert.name %> to reply.</p>
                <% } else { %>
                  <div class="answer-box mt-3"><%= q.answer %></div>
                  <div class="mt-2 small">
                    <% if (q.rating) { %>
                      You rated: <span class="stars"><%= stars(q.rating) %></span>
                    <% } else { %>
                      <%# Five buttons in one form: the clicked one sends its value as "rating" %>
                      <form action="/questions/<%= q.id %>/rate" method="post" class="d-inline">
                        Rate this answer:
                        <% for (let n = 1; n <= 5; n++) { %>
                          <button type="submit" name="rating" value="<%= n %>" title="<%= n %> out of 5"
                                  class="btn btn-link p-0 fs-5 stars text-decoration-none">☆</button>
                        <% } %>
                      </form>
                    <% } %>
                  </div>
                <% } %>
                <div class="text-end mt-2">
                  <form action="/questions/<%= q.id %>/delete" method="post" class="d-inline"
                        onsubmit="return confirm('Delete this question? This cannot be undone.');">
                    <button type="submit" class="btn btn-outline-danger btn-sm">Delete question</button>
                  </form>
                </div>
              <% } %>

            </div>
          </div>
        <% }); %>
      </div>

      <%# ---------- RIGHT: notifications (+ saved experts for users) ---------- %>
      <div class="col-12 col-lg-4">

        <div class="card mb-4" id="notifications">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <h2 class="h5 mb-0">🔔 Notifications</h2>
              <% if (unreadCount > 0) { %>
                <form action="/notifications/read" method="post">
                  <button type="submit" class="btn btn-link btn-sm p-0">Mark all as read</button>
                </form>
              <% } %>
            </div>
            <% if (notifications.length === 0) { %>
              <p class="text-muted small mb-0">No notifications yet.</p>
            <% } %>
            <% notifications.forEach(function (n) { %>
              <div class="small py-2 border-top <%= n.isRead ? 'text-muted' : 'fw-bold' %>">
                <%= n.message %>
                <div class="text-muted fw-normal"><%= formatDate(n.createdAt) %></div>
              </div>
            <% }); %>
          </div>
        </div>

        <% if (currentUser.role === 'user') { %>
          <div class="card">
            <div class="card-body">
              <h2 class="h5">♥ Saved experts</h2>
              <% if (savedExperts.length === 0) { %>
                <p class="text-muted small mb-0">You have not saved any experts yet.</p>
              <% } %>
              <% savedExperts.forEach(function (e) { %>
                <div class="d-flex align-items-center gap-2 py-2 border-top">
                  <div class="flex-grow-1">
                    <a href="/experts/<%= e.id %>" class="fw-bold"><%= e.name %></a>
                    <div class="small text-muted">
                      <%= e.expertProfile.specialty %> ·
                      <% if (e.ratingCount > 0) { %><span class="stars">★</span> <%= e.avgRating %><% } else { %>No ratings yet<% } %>
                    </div>
                  </div>
                  <a href="/ask/<%= e.id %>" class="btn btn-main btn-sm">Ask</a>
                  <%- include('partials/save_button', { expertId: e.id }) %>
                </div>
              <% }); %>
            </div>
          </div>
        <% } %>

      </div>
    </div>
  </div>

<%- include('partials/footer') %>
